<% layout("layout/boilerplate") %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');

  * { box-sizing: border-box; margin: 0; padding: 0; }

  .inbox-page { font-family: 'DM Sans', sans-serif; max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

  .inbox-title { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 600; color: #1a1a1a; margin-bottom: 0.4rem; }
  .inbox-sub { font-size: 13px; color: #888; margin-bottom: 2rem; }

  /* Chat Box */
  .chatbox {
    background: #fafaf8;
    border: 1px solid #eee;
    border-radius: 16px;
    padding: 1.2rem;
    height: 420px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .message-bubble {
    max-width: 70%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.5;
  }

  .message-bubble.me {
    align-self: flex-end;
    background: #1a1a1a;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .message-bubble.other {
    align-self: flex-start;
    background: #fff;
    border: 1px solid #e0e0d8;
    color: #333;
    border-bottom-left-radius: 4px;
  }

  .bubble-sender {
    font-size: 11px;
    font-weight: 500;
    margin-bottom: 4px;
    opacity: 0.6;
  }


  /* Input Area */
  .input-area {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .input-area input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid #e0e0d8;
    border-radius: 12px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    outline: none;
    transition: border 0.2s;
  }

  .input-area input:focus { border-color: #aaa; }

  .send-btn {
    background: #1a1a1a;
    color: #fff;
    border: none;
    padding: 12px 22px;
    border-radius: 12px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .send-btn:hover { background: #333; }

  .empty-state {
    text-align: center;
    color: #aaa;
    font-size: 14px;
    margin: auto;
  }
</style>

<div class="inbox-page">
  <h1 class="inbox-title">Inbox</h1>
  <p class="inbox-sub">Messages from your guests</p>

  <div class="chatbox" id="chatbox">
    <div class="empty-state" id="emptyState">No messages yet. Guests will appear here.</div>
  </div>

  <div class="input-area">
    <input type="text" id="msgInput" placeholder="Reply to guest..." />
    <button class="send-btn" id="sendBtn">Send</button>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const ownerId = "<%= ownerId %>";
  const myUsername = "<%= currentUser.username %>";

  // Owner joins their own room
  socket.emit("joinRoom", ownerId);

  // Send message
  document.getElementById("sendBtn").addEventListener("click", () => {
    sendMessage();
  });

  // Send on Enter key
  document.getElementById("msgInput").addEventListener("keydown", (e) => {
    if (e.key === "Enter") sendMessage();
  });

  function sendMessage() {
    let msg = document.getElementById("msgInput").value.trim();
    if (!msg) return;
    socket.emit("sendMessage", {
      sender: myUsername,
      message: msg,
      ownerId: ownerId
    });
    document.getElementById("msgInput").value = "";
  }

  // Receive message
  socket.on("receiveMessage", (data) => {
    // Remove empty state
    let empty = document.getElementById("emptyState");
    if (empty) empty.remove();

    let bubble = document.createElement("div");
    bubble.classList.add("message-bubble");
    bubble.classList.add(data.sender === myUsername ? "me" : "other");

    bubble.innerHTML = `
      <div class="bubble-sender">${data.sender}</div>
      <div class="bubble-text">${data.message}</div>
    `;

    let chatbox = document.getElementById("chatbox");
    chatbox.appendChild(bubble);
    chatbox.scrollTop = chatbox.scrollHeight; // auto scroll to bottom
  });
</script>