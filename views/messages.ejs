<% layout("layout/boilerplate") %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');

  * { box-sizing: border-box; margin: 0; padding: 0; }

  .chat-page { font-family: 'DM Sans', sans-serif; max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

  .chat-header { display: flex; align-items: center; gap: 14px; margin-bottom: 1.5rem; padding-bottom: 1.2rem; border-bottom: 1px solid #eee; }
  .chat-avatar { width: 46px; height: 46px; border-radius: 50%; background: #1a1a1a; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 500; flex-shrink: 0; }
  .chat-header-info h2 { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 600; color: #1a1a1a; }
  .chat-header-info p { font-size: 12px; color: #22c55e; font-weight: 500; margin-top: 2px; }

  .chatbox {
    background: #fafaf8;
    border: 1px solid #eee;
    border-radius: 16px;
    padding: 1.2rem;
    height: 420px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .chatbox::-webkit-scrollbar { width: 4px; }
  .chatbox::-webkit-scrollbar-thumb { background: #ddd; border-radius: 4px; }

  .empty-state { text-align: center; color: #bbb; font-size: 14px; margin: auto; }

  .message-bubble {
    max-width: 70%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.5;
    word-break: break-word;
  }

  .message-bubble.me {
    align-self: flex-end;
    background: #1a1a1a;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .message-bubble.other {
    align-self: flex-start;
    background: #fff;
    border: 1px solid #e0e0d8;
    color: #333;
    border-bottom-left-radius: 4px;
  }

  .bubble-sender { font-size: 11px; font-weight: 500; margin-bottom: 4px; opacity: 0.6; }

  .input-area { display: flex; gap: 10px; align-items: center; }

  .input-area input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid #e0e0d8;
    border-radius: 12px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    outline: none;
    transition: border 0.2s;
    background: #fff;
  }

  .input-area input:focus { border-color: #aaa; }

  .send-btn {
    background: #1a1a1a;
    color: #fff;
    border: none;
    padding: 12px 22px;
    border-radius: 12px;
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .send-btn:hover { background: #333; }
</style>

<div class="chat-page">

  <!-- Header -->
  <div class="chat-header">
    <div class="chat-avatar">O</div>
    <div class="chat-header-info">
      <h2>Owner</h2>
      <p>● Online</p>
    </div>
  </div>

  <!-- Chatbox -->
  <div class="chatbox" id="chatbox">
    <div class="empty-state" id="emptyState">
      <i class="fa-regular fa-comment-dots" style="font-size:2rem; margin-bottom:8px; display:block;"></i>
      No messages yet. Start the conversation!
    </div>
  </div>

  <!-- Input -->
  <div class="input-area">
    <input type="text" id="msgInput" placeholder="Type a message..." />
    <button class="send-btn" id="sendBtn">
      Send <i class="fa-solid fa-paper-plane"></i>
    </button>
  </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const ownerId = "<%= ownerId %>";
  const myUsername = "<%= currentUser.username %>";

  socket.emit("joinRoom", ownerId);

  function sendMessage() {
    let msg = document.getElementById("msgInput").value.trim();
    if (!msg) return;
    socket.emit("sendMessage", {
      sender: myUsername,
      message: msg,
      ownerId: ownerId
    });
    document.getElementById("msgInput").value = "";
  }

  document.getElementById("sendBtn").addEventListener("click", sendMessage);
  document.getElementById("msgInput").addEventListener("keydown", (e) => {
    if (e.key === "Enter") sendMessage();
  });

  socket.on("receiveMessage", (data) => {
    let empty = document.getElementById("emptyState");
    if (empty) empty.remove();

    let bubble = document.createElement("div");
    bubble.classList.add("message-bubble");
    bubble.classList.add(data.sender === myUsername ? "me" : "other");
    bubble.innerHTML = `
      <div class="bubble-sender">${data.sender}</div>
      ${data.message}
    `;
    let chatbox = document.getElementById("chatbox");
    chatbox.appendChild(bubble);
    chatbox.scrollTop = chatbox.scrollHeight;
  });
</script>